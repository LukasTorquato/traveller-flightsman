# Traveller — user-specific settings
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored; this template (`.env.example`) IS committed.

# Email address where deal notifications are sent.
TRAVELLER_EMAIL=your-email@example.com

# Your home/origin airport IATA code (3-letter, e.g. DUB, LHR, JFK, MAD).
TRAVELLER_ORIGIN_IATA=DUB

# Currency for all prices (3-letter ISO, e.g. EUR, GBP, USD).
TRAVELLER_CURRENCY=EUR

# Your local timezone (IANA name). Determines the "first Tuesday of the month"
# check, report filenames, and the meaning of "today" in the scan.
# Examples: Europe/Dublin, Europe/London, America/New_York, Asia/Tokyo.
TRAVELLER_TIMEZONE=Europe/Dublin

# First name used in email greetings. Keep short; defaults to "traveller" if
# blank. Examples: Lukas, Jamie, Alex.
TRAVELLER_NAME=traveller
